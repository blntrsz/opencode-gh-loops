{
  "name": "opencode-gh-loops",
  "version": "0.0.0",
  "private": true,
  "description": "Snapshot-bound OpenCode pull request reviews.",
  "type": "module",
  "scripts": {
    "build": "vp pack && bun run scripts/build-worker.ts",
    "smoke": "bun scripts/smoke-worker.ts",
    "smoke:failures": "node worker/smoke-failures.ts",
    "smoke:stdin": "node worker/smoke-stdin.ts",
    "smoke:generation": "node worker/smoke-generation.ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "bun@1.4.3"
}
