{
  "name": "opencode-gh-loops",
  "version": "0.0.0",
  "private": true,
  "description": "Snapshot-bound OpenCode pull request reviews.",
  "type": "module",
  "scripts": {
    "review": "bun run ./src/review/index.ts",
    "smoke": "bun run scripts/smoke-worker.ts",
    "smoke:action": "bun run scripts/smoke-action.ts",
    "smoke:failures": "bun run src/_agent/smoke-failures.ts",
    "smoke:stdin": "bun run src/_agent/smoke-stdin.ts",
    "smoke:generation": "bun run src/_agent/smoke-generation.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@opencode/plugin": "2.0.25",
    "@opencode/schema": "2.0.25",
    "@opencode/sdk": "2.0.25",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
